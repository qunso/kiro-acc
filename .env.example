# Server
HOST=0.0.0.0
PORT=8787
DATA_DIR=./data

# Public API key (Authorization: Bearer <key> or x-api-key)
API_KEY=change-me-api-key

# Admin API token (x-admin-token or Authorization: Bearer)
ADMIN_TOKEN=change-me-admin-token

# Account pool
ACCOUNT_STRATEGY=round-robin
BASE_COOLDOWN_MS=60000
QUOTA_RESET_MS=3600000
TOKEN_REFRESH_BEFORE_EXPIRY_SEC=300

# Preferred Kiro endpoint: codewhisperer | amazonq
PREFERRED_ENDPOINT=codewhisperer

# Optional global outbound proxy (per-account outboundProxyUrl overrides these)
# HTTP(S):  http://127.0.0.1:7890
# SOCKS5:   socks5://127.0.0.1:1080
# SOCKS5h:  socks5h://127.0.0.1:1080   (DNS via proxy; recommended with ss-local)
# ALL_PROXY=
# HTTP_PROXY=
# HTTPS_PROXY=
