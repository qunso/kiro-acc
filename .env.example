# Server
HOST=0.0.0.0
PORT=8787
DATA_DIR=./data

# Public API key (Authorization: Bearer <key> or x-api-key)
API_KEY=change-me-api-key

# Admin API / UI token (x-admin-token)
ADMIN_TOKEN=change-me-admin-token

# Account pool
ACCOUNT_STRATEGY=round-robin
BASE_COOLDOWN_MS=60000
MAX_COOLDOWN_MULTIPLIER=1440
QUOTA_RESET_MS=3600000
PROBABILISTIC_RETRY_CHANCE=0.1
TOKEN_REFRESH_BEFORE_EXPIRY_SEC=300
MAX_RETRIES=3

# Preferred Kiro endpoint: codewhisperer | amazonq
PREFERRED_ENDPOINT=codewhisperer

# Optional global outbound proxy (per-account outboundProxyUrl overrides)
# ALL_PROXY=
# HTTP_PROXY=
# HTTPS_PROXY=

# Optional: pin Kiro IDE version used in upstream User-Agent (skip auto-fetch)
# KIRO_IDE_VERSION=1.1.14

# getUsageLimits-only UA pin (BuilderId: 1.1.x → 400 Invalid profileArn; 0.6.18 OK).
# Chat/generateAssistantResponse still uses KIRO_IDE_VERSION / auto-fetch.
# KIRO_USAGE_LIMITS_IDE_VERSION=0.6.18
# KIRO_USAGE_LIMITS_AWS_SDK_VERSION=1.0.18


# Exit health probe (万-scale safe: sharded ticks, NOT full-pool every interval)
# Default mode = liveness via sticky SS → Amazon Q host (no third-party IP echo).
# For egress IP verify, set URL to your public gateway echo:
#   EXIT_HEALTH_PROBE_URL=https://<your-gateway>/egress-echo
# Do NOT point mass probes at api.ipify.org / ifconfig.me — they rate-limit at 万 scale.
# EXIT_HEALTH_PROBE_ENABLED=true
# EXIT_HEALTH_PROBE_MODE=auto
# EXIT_HEALTH_PROBE_TICK_MS=45000
# EXIT_HEALTH_PROBE_BATCH_SIZE=10
# EXIT_HEALTH_PROBE_CONCURRENCY=10
# EXIT_HEALTH_PROBE_STAGGER_MS=50
# EXIT_HEALTH_PROBE_TIMEOUT_MS=10000
# EXIT_HEALTH_PROBE_INITIAL_DELAY_MS=20000
# EXIT_HEALTH_PROBE_URL=
# EXIT_HEALTH_PROBE_CONNECT_URL=https://q.us-east-1.amazonaws.com/
# EXIT_HEALTH_PROBE_HOT_MIN_INTERVAL_MS=300000
# EXIT_HEALTH_PROBE_WARM_MIN_INTERVAL_MS=1800000
# EXIT_HEALTH_PROBE_COLD_MIN_INTERVAL_MS=21600000
# On-assign probe for unknown/stale exits before binding a new account:
# EXIT_ASSIGN_PROBE_ENABLED=true
# EXIT_ASSIGN_PROBE_STALE_MS=3600000
# EXIT_ASSIGN_PROBE_MAX_ATTEMPTS=5


# EXIT_HEALTH_PROBE_ENABLED=true
# EXIT_HEALTH_PROBE_INTERVAL_MS=300000
# EXIT_HEALTH_PROBE_CONCURRENCY=3
# EXIT_HEALTH_PROBE_STAGGER_MS=400
# EXIT_HEALTH_PROBE_TIMEOUT_MS=15000
# EXIT_HEALTH_PROBE_INITIAL_DELAY_MS=15000
# EXIT_HEALTH_PROBE_URL=https://api.ipify.org
